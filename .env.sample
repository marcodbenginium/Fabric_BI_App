# ──────────────────────────────────────────────────────────────
# Azure AD (Entra ID) — App Registration
# Portal: https://portal.azure.com → Microsoft Entra ID → App registrations
# ──────────────────────────────────────────────────────────────

# Application (client) ID
AZURE_CLIENT_ID=

# Client secret value (crea in: App registration → Certificates & secrets)
AZURE_CLIENT_SECRET=

# Directory (tenant) ID
AZURE_TENANT_ID=

# ──────────────────────────────────────────────────────────────
# Microsoft Fabric Data Agents
# Recupera gli URL da: Fabric Data Agent → Settings → Published URL
# (ogni agente deve essere pubblicato prima di usarlo)
# ──────────────────────────────────────────────────────────────

# Agente 1 — BI / Revenue (nome Fabric: TEST_COPILOT)
FABRIC_AGENT_TEST_COPILOT_URL=https://api.fabric.microsoft.com/v1/workspaces/<workspaceId>/dataagents/<agentId>/aiassistant/openai

# Agente 2 — HR / Dipendenti (nome Fabric: AGENTE_DASHBOARD_HR)
FABRIC_AGENT_DASHBOARD_HR_URL=https://api.fabric.microsoft.com/v1/workspaces/<workspaceId>/dataagents/<agentId>/aiassistant/openai

# Aggiungere qui gli URL di altri agenti futuri (vedi agents_registry.py):
# FABRIC_SUPPLY_AGENT_URL=https://api.fabric.microsoft.com/v1/workspaces/.../dataagents/.../aiassistant/openai

# Timeout polling in secondi (default: 120)
FABRIC_AGENT_TIMEOUT=120

# ──────────────────────────────────────────────────────────────
# App settings
# ──────────────────────────────────────────────────────────────

# URI di redirect registrato nell'App Registration Azure AD
# In produzione: https://tuodominio.com/auth/callback
REDIRECT_URI=http://localhost:5000/auth/callback

# Chiave segreta Flask per la firma dei cookie di sessione
# Genera con: python -c "import secrets; print(secrets.token_hex(32))"
FLASK_SECRET_KEY=

# Porta del server (default: 5000)
PORT=5000
