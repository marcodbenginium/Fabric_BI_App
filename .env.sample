# ──────────────────────────────────────────────────────────────
# Azure AD (Entra ID) — App Registration
# Portal: https://portal.azure.com → Microsoft Entra ID → App registrations
# ──────────────────────────────────────────────────────────────

# Application (client) ID
AZURE_CLIENT_ID=

# Client secret value (crea in: App registration → Certificates & secrets)
AZURE_CLIENT_SECRET=

# Directory (tenant) ID
AZURE_TENANT_ID=

# ──────────────────────────────────────────────────────────────
# Microsoft Fabric Data Agent
# Recupera questo URL da: Fabric Data Agent → Settings → Published URL
# (deve essere pubblicato prima di usarlo)
# ──────────────────────────────────────────────────────────────

FABRIC_AGENT_PUBLISHED_URL=https://api.fabric.microsoft.com/v1/workspaces/<workspaceId>/dataagents/<agentId>/aiassistant/openai

# Timeout polling in secondi (default: 120)
FABRIC_AGENT_TIMEOUT=120

# ──────────────────────────────────────────────────────────────
# App settings
# ──────────────────────────────────────────────────────────────

# URI di redirect registrato nell'App Registration Azure AD
# In produzione: https://tuodominio.com/auth/callback
REDIRECT_URI=http://localhost:5000/auth/callback

# Chiave segreta Flask per la firma dei cookie di sessione
# Genera con: python -c "import secrets; print(secrets.token_hex(32))"
FLASK_SECRET_KEY=

# Porta del server (default: 5000)
PORT=5000
